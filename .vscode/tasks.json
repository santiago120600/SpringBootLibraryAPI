{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "podman machine start",
			"type": "shell",
			"command": "podman machine start",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "podman compose up build dev",
			"type": "shell",
			"command": "podman",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"args": [
				"compose",
				"-f", 
				"docker/dev/docker-compose.yaml",
				"up",
				"--build",
				"-d"
			],
			"problemMatcher": []
		},
		{
			"label": "podman compose up build prod",
			"type": "shell",
			"command": "podman",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"args": [
				"compose",
				"-f", 
				"docker/prod/docker-compose.yaml",
				"up",
				"--build",
				"-d"
			],
			"problemMatcher": []
		},
		{
			"label": "podman compose down prod",
			"type": "shell",
			"command": "podman",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"args": [
				"compose",
				"-f", 
				"docker/prod/docker-compose.yaml",
				"down"
			],
			"problemMatcher": []
		},
		{
			"label": "podman compose down dev",
			"type": "shell",
			"command": "podman",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"args": [
				"compose",
				"-f", 
				"docker/dev/docker-compose.yaml",
				"down"
			],
			"problemMatcher": []
		}
	]
}